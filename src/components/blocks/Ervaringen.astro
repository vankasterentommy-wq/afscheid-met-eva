---
import { tinaField } from '@tinacms/astro/tina-field';
import type { PaginaBlokkenErvaringen } from '../../../tina/__generated__/types';

interface Props {
  data: PaginaBlokkenErvaringen;
}
const { data: d } = Astro.props;
const items = (d.ervaringen ?? []).filter((e): e is NonNullable<typeof e> => !!e);
const info = d.infokaart && (d.infokaart.titel || d.infokaart.tekst) ? d.infokaart : null;
const enkel = !info && items.length === 1;
/** Lange ervaringen in het leeslettertype (de sierletter is voor korte citaten). */
const lang = (t?: string | null) => (t ?? '').length > 200;
---
<section data-tina-field={tinaField(d)}>
  <div class="wrap sec">
    {enkel ? (
      <div class="review" data-tina-field={tinaField(items[0])}>
        {items[0].label && <span class="eb c" data-tina-field={tinaField(items[0], 'label')}>{items[0].label}</span>}
        <p class:list={{ lang: lang(items[0].citaat), klap: lang(items[0].citaat) }} id={`erv-${items[0].naam?.replace(/\W+/g, '-')}`} data-tina-field={tinaField(items[0], 'citaat')}>"{items[0].citaat}"</p>
        {lang(items[0].citaat) && <button type="button" class="leesmeer" aria-expanded="false" aria-controls={`erv-${items[0].naam?.replace(/\W+/g, '-')}`}>Lees verder</button>}
        {items[0].naam && <span class="muted" style="font-size:15px" data-tina-field={tinaField(items[0], 'naam')}>{items[0].naam}</span>}
      </div>
    ) : (
      <div class="trio" style={`--n:${Math.min(3, items.length + (info ? 1 : 0)) || 1}`}>
        {info && (
          <div class="blush" data-tina-field={tinaField(info)}>
            {info.eyebrow && <span class="eb" data-tina-field={tinaField(info, 'eyebrow')}>{info.eyebrow}</span>}
            {info.titel && <h3 data-tina-field={tinaField(info, 'titel')}>{info.titel}</h3>}
            {info.tekst && <p style="color:var(--text);font-size:16px" data-tina-field={tinaField(info, 'tekst')}>{info.tekst}</p>}
          </div>
        )}
        {items.map((e) => (
          <div class="white" data-tina-field={tinaField(e)}>
            {e.label && <span class="eb" data-tina-field={tinaField(e, 'label')}>{e.label}</span>}
            <p class:list={['q', { lang: lang(e.citaat), klap: lang(e.citaat) }]} id={`erv-${e.naam?.replace(/\W+/g, '-')}`} data-tina-field={tinaField(e, 'citaat')}>"{e.citaat}"</p>
            {lang(e.citaat) && <button type="button" class="leesmeer" aria-expanded="false" aria-controls={`erv-${e.naam?.replace(/\W+/g, '-')}`}>Lees verder</button>}
            {e.naam && <span class="muted" style="font-size:15px" data-tina-field={tinaField(e, 'naam')}>{e.naam}</span>}
          </div>
        ))}
      </div>
    )}
  </div>
</section>

<script>
  // Lange ervaringen op de telefoon: eerst een paar regels, "Lees verder" klapt uit
  document.addEventListener('click', (e) => {
    const knop = (e.target as Element | null)?.closest<HTMLButtonElement>('.leesmeer');
    if (!knop) return;
    const tekst = document.getElementById(knop.getAttribute('aria-controls') ?? '');
    const open = knop.getAttribute('aria-expanded') !== 'true';
    tekst?.classList.toggle('open', open);
    knop.setAttribute('aria-expanded', String(open));
    knop.textContent = open ? 'Minder tonen' : 'Lees verder';
  });
</script>
