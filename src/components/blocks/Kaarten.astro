---
import { tinaField } from '@tinacms/astro/tina-field';
import Img from '../ui/Img.astro';
import { lines, safeUrl } from '../../lib/util';
import type { PaginaBlokkenKaarten } from '../../../tina/__generated__/types';

interface Props {
  data: PaginaBlokkenKaarten;
  /** Plek van dit blok op de pagina; direct onder de paginakop laadt de eerste foto meteen. */
  index?: number;
}
const { data: d, index = 99 } = Astro.props;
const kaarten = (d.kaarten ?? []).filter((k): k is NonNullable<typeof k> => !!k);
const titel = lines(d.titel);
const sizes = kaarten.length > 3 ? '(min-width: 861px) 25vw, 78vw' : '(min-width: 861px) 33vw, 78vw';
---
<section class="wrap sec" data-tina-field={tinaField(d)}>
  {titel.length ? (
    <div class="stack center" style="margin-bottom:28px">
      {d.eyebrow && <span class="eb c" data-tina-field={tinaField(d, 'eyebrow')}>{d.eyebrow}</span>}
      <h2 data-tina-field={tinaField(d, 'titel')}>{titel.map((l, i) => <>{i > 0 && <br />}{l}</>)}</h2>
      {d.intro && <p class="lead" style="max-width:620px" data-tina-field={tinaField(d, 'intro')}>{d.intro}</p>}
    </div>
  ) : d.intro ? (
    <p style="color:var(--text);max-width:720px;margin:0 0 22px" data-tina-field={tinaField(d, 'intro')}>{d.intro}</p>
  ) : null}
  <div class:list={['cards', { c3: kaarten.length <= 3 }]}>
    {kaarten.map((k, ki) => {
      const pos = k.fotoPositie ? `object-position:${k.fotoPositie}` : undefined;
      const img = <Img src={k.foto} alt={k.fotoAlt} style={pos} eager={index <= 1 && ki === 0} widths={[400, 640, 800]} sizes={sizes} field={tinaField(k, 'foto')} />;
      const url = safeUrl(k.link);
      if (url) {
        return (
          <a href={url} class="pcard" data-tina-field={tinaField(k)}>
            {img}
            <span class="b">
              <h3 data-tina-field={tinaField(k, 'titel')}>{k.titel}</h3>
              {k.subtitel && <span class="sub" data-tina-field={tinaField(k, 'subtitel')}>{k.subtitel}</span>}
              {k.tekst && <p data-tina-field={tinaField(k, 'tekst')}>{k.tekst}</p>}
            </span>
          </a>
        );
      }
      const metLijst = !!k.lijst?.length;
      return (
        <div class="pcard l" data-tina-field={tinaField(k)}>
          {img}
          <div class="b">
            {metLijst && k.subtitel && <span class="sub" data-tina-field={tinaField(k, 'subtitel')}>{k.subtitel}</span>}
            <h3 data-tina-field={tinaField(k, 'titel')}>{k.titel}</h3>
            {!metLijst && k.subtitel && <span class="sub" data-tina-field={tinaField(k, 'subtitel')}>{k.subtitel}</span>}
            {k.tekst && <p data-tina-field={tinaField(k, 'tekst')}>{k.tekst}</p>}
            {metLijst && <ul class="check">{k.lijst!.map((l, i) => <li data-tina-field={tinaField(k, 'lijst', i)}>{l}</li>)}</ul>}
          </div>
        </div>
      );
    })}
  </div>
  <div class="dots" aria-hidden="true">{kaarten.map(() => <i></i>)}</div>
</section>
